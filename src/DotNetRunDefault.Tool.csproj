<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>run-default</ToolCommandName>
    <PackageId>dotnet-run-default</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ryan Erdmann</Authors>
    <Description>Runs the DefaultStartup project from a .slnx file.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ryanerdmann/dotnet-run-default</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ryanerdmann/dotnet-run-default</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;cli;tool;slnx;startup</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
